<div class="container">
  <h1>Manage Events</h1>

  <form action="/events/admin/create" method="POST">
    <input type="text" name="title" placeholder="Event Title" required/>
    <select name="category" required>
      <option value="Technology">Technology</option>
      <option value="Music">Music</option>
      <option value="Business">Business</option>
    </select>
    <textarea name="description" placeholder="Description"></textarea>
    <input type="text" name="location" placeholder="Location" required />
    <input type="date" name="date" required/>
    <input type="number" name="totalCapacity" placeholder="Capacity" required/>
    <button type="submit">Create Event</button>
  </form>

  <table>
    <tr>
      <th>Title</th>
      <th>Category</th>
      <th>Location</th>
      <th>Date</th>
      <th>Capacity</th>
      <th>Actions</th>
    </tr>

    <% events.forEach(event =>
    { %>
      <tr>
        <td><%= event.title %></td>
        <td><%= event.category %></td>
        <td><%= event.location %></td>
        <td><%= new Date(event.date).toDateString() %></td>
        <td><%= event.totalCapacity %></td>
        <td>
          <a href="/events/admin/edit/<%= event._id %>" class="btn">Edit</a>

          <form action="/events/admin/delete/<%= event._id %>" method="POST" style="display:inline;">
          <button type="submit" class="btn">Delete</button>
          </form>
        </td>
      </tr>
    <% }) %>
  </table>
</div>
