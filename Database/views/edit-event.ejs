<div class="container">
    <h1>Edit Event</h1>

    <form action="/events/admin/edit/<%= event._id %>" method="POST">
        <input type="text" name="title" value="<%= event.title %>" required>
        <select name="category" required>
            <option value="Technology" <%= event.category === 'Technology' ? 'selected' : '' %>>Technology</option>
            <option value="Music" <%= event.category === 'Music' ? 'selected' : '' %>>Music </option>
            <option value="Business" <%= event.category === 'Business' ? 'selected' : '' %>>Business </option>
        </select>
        <textarea name="description"><%= event.description %></textarea>
        <input type="text" name="location" value="<%= event.location %>" required>
        <input type="date" name="date" value="<%= event.date.toISOString().split('T')[0] %>" required>
        <input type="number" name="totalCapacity" value="<%= event.totalCapacity %>" required>
        <button type="submit">Update Event</button>
    </form>
</div>